# .env.development.example

# Development only. `just arena-dev` passes this file explicitly, so
# nothing here can reach a production recipe.

AIRLOCK_UI_DEV_PORT=61878

VITE_API_URL=/api
VITE_APP_TITLE=airlock arena (dev)
VITE_SITE_URL=

AIRLOCK_AUDIT_PATH=/var/lib/airlock/audit.jsonl
AIRLOCK_BYPASS_PATH=/var/lib/airlock/bypasses.jsonl
